OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=

WIKI_USERNAME=
WIKI_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

SOURCE_POLL_URL=
SOURCE_POLL_INTERVAL_MINUTES=120
AUTO_PUBLISH_OFFICIAL_NEWS=false
NEWS_SOURCE_TYPE=community
NEWS_POLLING_ENABLED=true

# ── LLM Provider Selection ────────────────────────────────────
# Supported providers: openai, deepseek, gemini, qwen, anthropic
# Each pipeline stage can use a different provider and model.

# Translation
TRANSLATION_PROVIDER=deepseek
TRANSLATION_MODEL=deepseek-v4-flash

# Review Agent
REVIEW_PROVIDER=deepseek
REVIEW_MODEL=deepseek-v4-flash

# Tagging Agemt
TAGGING_PROVIDER=deepseek
TAGGING_MODEL=deepseek-v4-flash

# ── Available models per provider ─────────────────────────────
# openai:     gpt-4o-mini, gpt-4o, gpt-4.1
# deepseek:   deepseek-v4-flash, deepseek-v4-pro
# gemini:     gemini-2.5-flash, gemini-2.5-pro
# qwen:       qwen-max, qwen-plus, qwen-turbo
# anthropic:  claude-3.5-sonnet, claude-3.5-haiku, claude-4-sonnet
